# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT="3000"

# Cloud SQL / PostgreSQL Runtime Connection Variables
# Configured via connection pooling using the Object Method
SQL_HOST="127.0.0.1"
SQL_USER="ai_studio_user"
SQL_PASSWORD="your_database_password"
SQL_DB_NAME="codetogether"

# Cloud SQL / PostgreSQL Admin Migration Variables (Used by drizzle-kit)
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="your_admin_password"
